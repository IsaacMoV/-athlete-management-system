		FROM eventos 
		WHERE id_evento IN 
        (
			SELECT id_evento 
            FROM compite_en
            WHERE matricula = c.matricula
		) ORDER BY fecha_fin 
		LIMIT 1
    ) AS nombreEv,  
    (
