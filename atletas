    Eventos AS EV ON CE.id_evento = EV.id_evento
WHERE
    EV.nombreEv = 'Maratón UNAM'
GROUP BY
    E.nombreEq;

-- Procedimiento sp_consultas

CREATE OR REPLACE FUNCTION sp_consultas(
	param_nom_eq CHAR(15),
	param_nom_at CHAR(15),
	param_ap_at CHAR(15),
	param_nom_ev CHAR(30),
	param_nom_dep CHAR(20)
)
RETURNS TABLE (
	nombre1 VARCHAR(30),
	nombre2 VARCHAR(30),
	puntos BIOGINT
)
LANGUAGE plpgsql
AS $$
BEGIN
	RETURN QUERY

	SELECT nombreAt,apellidoAt,
(
    	SELECT SUM(c.puntos_obt)
        	FROM compite_en c
        	WHERE c.matricula = atletas.matricula
) AS total_puntos
FROM atletas 
WHERE id_equipo = (
  	  SELECT id_equipo
   	 FROM equipos 
    	WHERE nombreEq = 'Halcones'
);

	RETURN QUERY

	SELECT 
(
	SELECT nombreEv 
	FROM eventos 
	WHERE id_evento IN 
        	(
SELECT id_evento 
         	FROM compite_en
         	WHERE matricula = c.matricula
	) ORDER BY fecha_fin 
LIMIT 1
) AS nombreEv,  
(
	SELECT nombreEs 
        	FROM especialidades 
        	WHERE id_especialidad 
        	IN 
	(
	SELECT id_especialidad 
         	FROM eventos 
         	WHERE id_evento IN 
          ( 
		SELECT id_evento
                	FROM compite_en 
                	WHERE matricula = c.matricula
	)
	)
) AS especialidad, 
(
SELECT sum(puntos_obt) 
        	FROM compite_en
        	WHERE matricula = c.matricula
	) AS puntos_tot 
    	FROM compite_en c 
    	WHERE matricula IN 
    	(
		SELECT matricula 
        		FROM atletas 
        		WHERE nombreAt = 'Juan' 
        		AND apellidoAt = 'Pérez');

	RETURN QUERY

	SELECT
    EV.nombreEv, 
    E.nombreEq,
    SUM(CE.puntos_obt) AS puntos_totales_del_equipo
FROM
    Equipos E
JOIN
    Atletas A ON E.id_equipo = A.id_equipo
JOIN
    compite_en CE ON A.matricula = CE.matricula
JOIN
    Eventos EV ON CE.id_evento = EV.id_evento
WHERE
    EV.nombreEv = 'Maratón UNAM'
GROUP BY
    E.nombreEq;

	RETURN QUERY

-- Devuelve el nombre y apellido y edad de los atletas que participan en el deporte referido.

	SELECT nombreAt, apellidoAt, EXTRACT(YEAR FROM AGE(CURRENT_DATE, fechnac)) AS edad FROM atletas WHERE id_equipo IN (SELECT id_equipo FROM equipos WHERE id_deporte IN (SELECT id_deporte FROM deportes WHERE nombreDep = 'Salto'));

	RETURN QUERY

-- Devuelve el nombre del equipo, nombre del jugador, y puntos obtenidos del jugador con mayor suma de puntos.

	SELECT
    e.nombreEq,
    a.nombreAt,
    SUM(c.puntos_obt) AS puntos_totales
FROM
    equipos e
JOIN
    atletas a ON e.id_equipo = a.id_equipo
JOIN
    compite_en c ON a.matricula = c.matricula
GROUP BY
    e.nombreEq, a.nombreAt;

END;
$$;

-- Procedimiento sp_borra

CREATE OR REPLACE FUNCTION sp_borra_entrenador(
    p_id_entrenador CHAR(6)
)
RETURNS TEXT
LANGUAGE plpgsql
AS $$
DECLARE
    v_count_equipos INTEGER;
    v_mensaje TEXT;
BEGIN
    -- Verificar si el entrenador existe
    IF NOT EXISTS (SELECT 1 FROM entrenadores WHERE id_entrenador = p_id_entrenador) THEN
        RETURN 'ERROR: El entrenador con ID ' || p_id_entrenador || ' no existe.';
    END IF;
    
    -- Verificar dependencias en tabla equipos
    SELECT COUNT(*) INTO v_count_equipos 
    FROM equipos 
    WHERE id_entrenador = p_id_entrenador;
    
    -- Si hay dependencias, no permitir eliminación
    IF v_count_equipos > 0 THEN
        RETURN 'ERROR: No se puede eliminar el entrenador. Tiene ' || v_count_equipos || ' equipos asignados.';
    END IF;
    
    -- Si no hay dependencias, proceder con la eliminación
    DELETE FROM entrenadores WHERE id_entrenador = p_id_entrenador;
    
    RETURN 'ÉXITO: Entrenador eliminado correctamente.';
    
EXCEPTION
    WHEN OTHERS THEN
        RETURN 'ERROR: ' || SQLERRM;
END;
$$;

