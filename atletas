        FROM especialidades 
        WHERE id_especialidad 
        IN 
		(
			SELECT id_especialidad 
            FROM eventos 
            WHERE id_evento IN 
            ( 
				SELECT id_evento
                FROM compite_en 
                WHERE matricula = c.matricula
			)
		)
	) AS especialidad, 
    (
		SELECT sum(puntos_obt) 
        FROM compite_en
        WHERE matricula = c.matricula
	) as puntos_tot 
    FROM compite_en c 
    WHERE matricula IN 
    (
		SELECT matricula 
        FROM atletas 
        WHERE nombreAt = 'Juan' 
        AND apellidoAt = 'Pérez');

