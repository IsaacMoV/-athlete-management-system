DROP DATABASE IF EXISTS atletas;

CREATE DATABASE atletas
    WITH 
    ENCODING = 'UTF8';

\c atletas

CREATE TABLE deportes (
	id_deporte CHAR(6) NOT NULL,
	nombreDep VARCHAR(20) NOT NULL
);

CREATE TABLE entrenadores (
	id_entrenador CHAR(6) NOT NULL,
	nombreEnt VARCHAR(15) NOT NULL,
	apellidoEnt VARCHAR(15) NOT NULL
);

CREATE TABLE divisiones (
	codigo_division CHAR(6) NOT NULL,
	nombreDiv VARCHAR(15) NOT NULL
);

CREATE TABLE equipos (
    	id_equipo CHAR(6) NOT NULL,
    	nombreEq VARCHAR(15) NOT NULL,
    	generoEq CHAR(1),
    	fecha_creacion DATE NOT NULL,
    	id_entrenador CHAR(6) NOT NULL,
    	codigo_division CHAR(6) NOT NULL,
	id_deporte CHAR(6) NOT NULL
);

CREATE TABLE atletas (
	matricula CHAR(6) NOT NULL,
	generoAt CHAR(1) NOT NULL,
	nombreAt VARCHAR(15) NOT NULL,
	apellidoAt VARCHAR(15) NOT NULL,
	fechnac DATE NOT NULL,
	calle VARCHAR(30) NOT NULL,
	numeroExt INT NOT NULL, 
	municipio VARCHAR(15) NOT NULL,
	id_equipo CHAR(6) NOT NULL
);

CREATE TABLE especialidades (
	id_especialidad CHAR(6) NOT NULL,
	nombreEs VARCHAR(15) NOT NULL,
	id_deporte CHAR(6) NOT NULL
);

CREATE TABLE recintos (
	id_recinto CHAR(6) NOT NULL,
	nombreRec VARCHAR(30) NOT NULL,
	calleRec VARCHAR(30) NOT NULL,
	numRec INT,
	municipioRec VARCHAR(15) NOT NULL
);

CREATE TABLE eventos (
	id_evento CHAR(6) NOT NULL,
	fecha_inicio DATE NOT NULL,
	fecha_fin DATE,
	nombreEv VARCHAR(30) NOT NULL,
	codigo_division CHAR(6) NOT NULL,
	id_recinto CHAR(6) NOT NULL,
	id_especialidad CHAR(6) NOT NULL
);

CREATE TABLE compite_en (
	matricula CHAR(6) NOT NULL,
	id_evento CHAR(6) NOT NULL,
	resultado SMALLINT,
	puntos_obt INT NOT NULL
);

\d atletas

--Creacion de llaves primarias y/o foráneas para la integridad de nuestro negocio

ALTER TABLE deportes
ADD CONSTRAINT pk_deportes PRIMARY KEY (id_deporte);

ALTER TABLE entrenadores
ADD CONSTRAINT pk_entrenadores PRIMARY KEY (id_entrenador);

ALTER TABLE divisiones
ADD CONSTRAINT pk_divisiones PRIMARY KEY (codigo_division);

ALTER TABLE equipos
ADD CONSTRAINT pk_equipos PRIMARY KEY (id_equipo),
ADD CONSTRAINT fk_deportes FOREIGN KEY (id_deporte) REFERENCES deportes(id_deporte),
ADD CONSTRAINT fk_divisiones FOREIGN KEY (codigo_division) REFERENCES divisiones(codigo_division),
ADD CONSTRAINT fk_entrenadores FOREIGN KEY (id_entrenador) REFERENCES entrenadores(id_entrenador);

ALTER TABLE atletas
ADD CONSTRAINT pk_atletas PRIMARY KEY (matricula),
ADD CONSTRAINT fk_equipos FOREIGN KEY (id_equipo) REFERENCES equipos(id_equipo);

ALTER TABLE especialidades
ADD CONSTRAINT pk_especialidades PRIMARY KEY (id_especialidad),
ADD CONSTRAINT fk_deportes2 FOREIGN KEY (id_deporte) REFERENCES deportes(id_deporte);

ALTER TABLE recintos
ADD CONSTRAINT pk_recintos PRIMARY KEY (id_recinto);

ALTER TABLE eventos
ADD CONSTRAINT pk_eventos PRIMARY KEY (id_evento),
ADD CONSTRAINT fk_recintos FOREIGN KEY (id_recinto) REFERENCES recintos(id_recinto),
ADD CONSTRAINT fk_divisiones2 FOREIGN KEY (codigo_division) REFERENCES divisiones(codigo_division);

ALTER TABLE compite_en
ADD CONSTRAINT pk_compite_en PRIMARY KEY (matricula, id_evento),
ADD CONSTRAINT fk_atletas FOREIGN KEY (matricula) REFERENCES atletas(matricula),
ADD CONSTRAINT fk_eventos FOREIGN KEY (id_evento) REFERENCES eventos(id_evento);

