ALTER TABLE eventos
ADD CONSTRAINT chk_fechas_evento CHECK (fecha_fin >= fecha_inicio);

-- Funcion para restricción de registro de atletas en eventos cuyo evento o división sea distinta.
CREATE OR REPLACE FUNCTION verificar_deporte_evento()
RETURNS TRIGGER AS $$
DECLARE
deporte_equipo CHAR(6);
   	especialidad_evento CHAR(6);
   	deporte_evento CHAR(6);
   	division_equipo CHAR(6);
   	division_evento CHAR(6);
BEGIN
   	SELECT e.id_deporte, e.codigo_division INTO deporte_equipo, division_equipo
   	FROM equipos e
   	JOIN atletas a ON e.id_equipo = a.id_equipo
    	WHERE a.matricula = NEW.matricula;

    	SELECT ev.id_especialidad, ev.codigo_division INTO especialidad_evento, division_evento
    	FROM eventos ev
    	WHERE ev.id_evento = NEW.id_evento;

    	SELECT s.id_deporte INTO deporte_evento
    	FROM especialidades s
    	WHERE s.id_especialidad = especialidad_evento;

    	IF deporte_equipo <> deporte_evento THEN
      	RAISE EXCEPTION 'No se puede inscribir un equipo en un evento de un deporte diferente.';
    	END IF;

    	IF division_equipo <> division_evento THEN
        	RAISE EXCEPTION 'No se puede inscribir un equipo en un evento de una división diferente.';
    	END IF;

    	RETURN NEW;
END;
$$ LANGUAGE plpgsql;

CREATE TRIGGER evitar_inscripcion_incorrecta
BEFORE INSERT ON compite_en
FOR EACH ROW
EXECUTE FUNCTION verificar_deporte_evento();

-- Funcion para restricción de registro de atletas en eventos cuyo equipo haya sido creado después del evento
CREATE OR REPLACE FUNCTION verificar_fecha_creacion_equipo()
RETURNS TRIGGER AS $$
DECLARE
    fecha_creacion_equipo DATE;
    fecha_inicio_evento DATE;
BEGIN
    -- Obtener la fecha de creación del equipo del atleta que se va a inscribir
    SELECT e.fecha_creacion INTO fecha_creacion_equipo
    FROM equipos e
    JOIN atletas a ON e.id_equipo = a.id_equipo
    WHERE a.matricula = NEW.matricula;

    -- Obtener la fecha de inicio del evento
    SELECT ev.fecha_inicio INTO fecha_inicio_evento
    FROM eventos ev
    WHERE ev.id_evento = NEW.id_evento;

    -- Comparar las fechas
    IF fecha_creacion_equipo > fecha_inicio_evento THEN
        RAISE EXCEPTION 'El equipo fue creado después de la fecha de inicio del evento.';
    END IF;

    RETURN NEW;
END;
$$ LANGUAGE plpgsql;

CREATE TRIGGER evitar_inscripcion_equipo_reciente
BEFORE INSERT ON compite_en
FOR EACH ROW
EXECUTE FUNCTION verificar_fecha_creacion_equipo();

